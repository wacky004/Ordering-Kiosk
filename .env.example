# Environment configuration
# Copy to .env (optional) or set these in your shell.

# HTTP port for the server
PORT=3000

# Secret used to sign session cookies. Change this for anything shared.
SESSION_SECRET=change-me-to-a-long-random-string

# Location of the SQLite database (defaults to data/kiosk.db)
# KIOSK_DB_PATH=./data/kiosk.db
